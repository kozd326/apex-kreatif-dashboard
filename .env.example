# APEX KREATİF — Supabase Bağlantı Bilgileri
# Supabase Dashboard > Project Settings > API sekmesinden kopyalayın
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Opsiyonel iletişim entegrasyonları — Railway > Variables alanına ekleyin.
# Bu anahtarları NEXT_PUBLIC_ ile başlatmayın ve GitHub'a eklemeyin.
RESEND_API_KEY=re_xxxxxxxxx
OUTBOUND_EMAIL_FROM=APEX KREATİF <iletisim@alanadiniz.com>
# Railway Cron ile planlı e-posta göndermek için yalnızca sunucuda kullanılır.
# Uzun, rastgele bir değer üretin; GitHub'a veya NEXT_PUBLIC_ değişkenlerine koymayın.
OUTREACH_CRON_SECRET=long-random-secret
# Yalnızca ayrı Railway Cron servisi için. Canlı uygulamanın dispatch uç noktası olmalı.
OUTREACH_DISPATCH_URL=https://your-app.up.railway.app/api/outreach/email/schedule/dispatch
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_API_VERSION=v22.0

# AI destekli kamuya açık dijital görünüm denetimi.
# Yalnızca Railway > Variables alanına ekleyin; NEXT_PUBLIC_ ile başlamamalı.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ANALYSIS_MODEL=gpt-5-mini
# Agent Center için opsiyonel ayrı model. Boş bırakılırsa OPENAI_ANALYSIS_MODEL kullanılır.
OPENAI_AGENT_MODEL=gpt-5-mini
# Tahmini maliyet için USD / 1 milyon token oranları. Model değişirse güncelleyin.
OPENAI_AGENT_INPUT_USD_PER_1M=0.25
OPENAI_AGENT_OUTPUT_USD_PER_1M=2
# Agent Center nihai raporlarını yalnızca sunucu yazabilsin diye gerekir.
# Supabase Dashboard > Project Settings > API alanındaki service_role anahtarını
# sadece Railway > Variables'a ekleyin; asla NEXT_PUBLIC_ ile başlamamalı.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
